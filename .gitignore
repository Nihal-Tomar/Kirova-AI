# ─── Kirova AI — .gitignore ───────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
server/dist/
client/dist/

# Environment files — NEVER commit secrets
.env
.env.local
.env.production
.env.*.local
server/.env
client/.env

# Database persistence (embedded PGlite — contains live data)
server/data/pgdata/

# Uploads (user-submitted files)
uploads/

# Logs
*.log
logs/
npm-debug.log*

# IDE / OS
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# TypeScript build info
*.tsbuildinfo

# Testing temp
coverage/
