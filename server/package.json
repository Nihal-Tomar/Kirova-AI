{
  "name": "kaaryasetu-server",
  "version": "1.0.0",
  "description": "KaaryaSetu AI Backend Server",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
