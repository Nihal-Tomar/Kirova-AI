# ── Kirova AI Client — Environment Variables Example ──────────────────────────
# For local development: copy to .env.local and fill in values.
# These VITE_ variables are embedded into the JS bundle at build time.
# They are NOT secrets — do not put anything sensitive here.

# Backend API base URL (no trailing slash)
# For local dev, the Vite proxy handles /api automatically, so this is optional.
# For production, set this to your Render backend URL in Vercel's env settings.
VITE_API_URL=https://kirova-api.onrender.com

# Google OAuth Client ID (from Google Cloud Console → Credentials)
# This is NOT a secret — it is safe to include in the browser bundle.
# The matching GOOGLE_CLIENT_ID on the server validates the aud claim.
VITE_GOOGLE_CLIENT_ID=
