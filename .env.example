# ─── Kirova AI — Environment Variables Example ────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# JWT Secret — generate with: openssl rand -base64 32
# REQUIRED in production. Must be at least 32 characters.
JWT_SECRET=your-secure-256-bit-secret-here

# ─── AI / STT Services ────────────────────────────────────────────────────────
# Sarvam AI (Hinglish / vernacular speech-to-text)
# Leave empty to use deterministic mock mode (no API calls)
SARVAM_API_KEY=

# LLM provider — provide ONE of the following:
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave empty to use embedded PGlite (default, zero config)
# Set to a real PostgreSQL URL for production cloud deployment:
# DATABASE_URL=postgresql://user:password@host:5432/kirova_db
DATABASE_URL=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example: https://kirova-ai.vercel.app,https://www.kirova.ai
ALLOWED_ORIGINS=http://localhost:5173
